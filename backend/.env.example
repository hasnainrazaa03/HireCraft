# Copy to .env and fill in. Never commit .env.

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Security ---
# Generate with: openssl rand -base64 48
SECRET_KEY=change-me-generate-a-real-random-value

# --- Database / Redis ---
DATABASE_URL=postgresql+psycopg://hirecraft:hirecraft@localhost:5432/hirecraft
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- LLM providers (multi-provider) ---
# The default provider used when a user hasn't chosen one. One of:
# gemini | anthropic | openai. Users can switch (and pick a model) in Settings,
# and bring their own key per provider. A provider is only usable if a key is
# available (server key here, or the user's own).
DEFAULT_LLM_PROVIDER=gemini

# Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Stable alias for the current Flash model. Avoid pinning gemini-2.0-flash:
# newer keys get a zero free-tier quota on it and every request fails with 429.
GEMINI_MODEL=gemini-flash-latest

# Anthropic (Claude) — optional. Key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI — optional. Key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Fallback pricing for cost tracking (USD per 1M tokens) for any model not in
# the built-in registry. Catalogued models use their own listed prices.
LLM_INPUT_COST_PER_MTOK=0.10
LLM_OUTPUT_COST_PER_MTOK=0.40

# --- Job search sources (all free / keyless) ---
# Which aggregator sources to pull from: arbeitnow · remotive · remoteok · github
JOB_SOURCES=arbeitnow,remotive,remoteok,github
# GitHub job-listing repos ("owner/repo", comma-separated). Read as a structured
# listings.json when present (the Simplify format), else parsed from the README
# table. Add your own repo here.
GITHUB_JOB_REPOS=SimplifyJobs/Summer2026-Internships,SimplifyJobs/New-Grad-Positions

# --- OAuth sign-in (optional) ---
# Fill in a provider's pair to show its "Continue with …" button. The provider's
# callback/redirect URI must be:
#   <this API's base>/api/v1/auth/oauth/<provider>/callback
# For local dev that's:  http://localhost:8000/api/v1/auth/oauth/google/callback
#                    and  http://localhost:8000/api/v1/auth/oauth/github/callback
# (Set OAUTH_REDIRECT_BASE if the API is reached at a different host than requests.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=

# --- Paths ---
TEMPLATES_DIR=../templates
ARTIFACTS_DIR=./artifacts

# --- Frontend ---
CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- Email (optional) ---
# Leave SMTP_HOST empty to run in console mode: emails are logged, not sent.
# Set these to a provider (Resend, Postmark, SES, Gmail SMTP) to deliver for real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=HireCraft <no-reply@hirecraft.app>
