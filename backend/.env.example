# Copy to .env and fill in. Never commit .env.

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Security ---
# Generate with: openssl rand -base64 48
SECRET_KEY=change-me-generate-a-real-random-value

# --- Database / Redis ---
DATABASE_URL=postgresql+psycopg://hirecraft:hirecraft@localhost:5432/hirecraft
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Gemini ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Stable alias for the current Flash model. Avoid pinning gemini-2.0-flash:
# newer keys get a zero free-tier quota on it and every request fails with 429.
GEMINI_MODEL=gemini-flash-latest

# Pricing used for cost tracking, USD per 1M tokens. Update these to match your
# chosen model's published rates so the cost figures stay accurate.
LLM_INPUT_COST_PER_MTOK=0.10
LLM_OUTPUT_COST_PER_MTOK=0.40

# --- Paths ---
TEMPLATES_DIR=../templates
ARTIFACTS_DIR=./artifacts

# --- Frontend ---
CORS_ORIGINS=http://localhost:5173
