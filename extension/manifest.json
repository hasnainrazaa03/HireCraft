{
  "manifest_version": 3,
  "name": "HireCraft",
  "version": "0.2.0",
  "description": "Clip a job posting into HireCraft, and fill its application form with your details and r\u00e9sum\u00e9.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.ashbyhq.com/*",
        "https://*.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.icims.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.workable.com/*",
        "https://*.jobvite.com/*",
        "https://*.bamboohr.com/*",
        "https://*.breezy.hr/*",
        "https://*.recruitee.com/*",
        "https://*.teamtailor.com/*",
        "https://*.oraclecloud.com/*",
        "https://*.successfactors.com/*",
        "https://*.avature.net/*",
        "https://*.eightfold.ai/*",
        "https://*.dover.com/*",
        "https://*.rippling.com/*"
      ],
      "js": [
        "autofill/visa.js",
        "autofill/submission.js",
        "autofill/options.js",
        "autofill/posting.js",
        "autofill/fields.js",
        "autofill/fill.js",
        "autofill/adapters.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HireCraft",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
